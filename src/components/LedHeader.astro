---
import { SITE_TITLE } from '../consts';
---

<div class="led-header" role="img" aria-label={SITE_TITLE}>
	<canvas id="led-canvas"></canvas>
</div>

<style>
	.led-header {
		width: 100%;
		background: #000;
		line-height: 0;
		padding-top: 1rem;
	}

	#led-canvas {
		display: block;
		width: 100%;
	}
</style>

<!--
	The script driving this canvas is the shared, cached public/site.js,
	loaded once from src/layouts/Layout.astro (it also runs the footer clock).
-->

