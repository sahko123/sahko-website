---
import { SITE_TITLE } from '../consts';
---

<div class="led-header" role="img" aria-label={SITE_TITLE}>
	<canvas id="led-canvas"></canvas>
</div>

<style>
	.led-header {
		width: 100%;
		background: #000;
		line-height: 0;
		padding-top: 1rem;
	}

	#led-canvas {
		display: block;
		width: 100%;
	}
</style>

<!--
	Plain static file (public/led-header.js), not an Astro-processed inline
	script — this component renders on every page, so serving it as one
	external file lets the browser cache it once instead of re-downloading
	an identical inlined copy per page. Keep public/led-header.js in sync if
	you change this component's behavior; see its header comment.
-->
<script src="/led-header.js" defer></script>
