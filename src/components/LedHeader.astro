---
import { SITE_TITLE } from '../consts';
---

<div class="led-header" role="img" aria-label={SITE_TITLE}>
	<canvas id="led-canvas"></canvas>
</div>

<style>
	.led-header {
		width: 100%;
		background: #000;
		line-height: 0;
		padding-top: 1rem;
	}

	#led-canvas {
		display: block;
		width: 100%;
	}
</style>

<script>
	import { buildTextColumns, LETTER_HEIGHT } from '../led-font';

	const ROWS = LETTER_HEIGHT;
	const ORANGE = '255,140,0';
	const BASE_ALPHA = 0.06;
	const SWEEP_MS = 2400;
	const HALF_BAND = 14; // columns of falloff on either side of the wave's center
	const SPARK_TAU = 90; // ms, how fast an un-reignited spark fades
	const LOCK_TAU = 90; // ms, how fast a passed column settles to its final state
	const LOCK_TAIL = 400; // ms, extra time after the sweep for the lock-in to converge
	const STORAGE_KEY = 'sahko:led-header-played';

	const wrap = document.querySelector<HTMLDivElement>('.led-header');
	const canvas = document.getElementById('led-canvas') as HTMLCanvasElement | null;
	if (wrap && canvas) {
		const ctx = canvas.getContext('2d')!;
		const letterCols = buildTextColumns('SAHKO');

		let columns = 0;
		let cellSize = 8;
		let gap = 2;
		let offsetX = 0;
		let letterStart = 0;
		let cssWidth = 0;
		let cssHeight = 0;
		let brightness: Float32Array = new Float32Array(0);

		function metricsFor(width: number) {
			if (width < 400) return { size: 5, gap: 1 };
			if (width < 640) return { size: 6, gap: 2 };
			if (width < 1024) return { size: 8, gap: 2 };
			return { size: 10, gap: 3 };
		}

		function layout() {
			const width = wrap!.clientWidth;
			const m = metricsFor(width);
			cellSize = m.size;
			gap = m.gap;
			columns = Math.max(letterCols.length, Math.floor((width + gap) / (cellSize + gap)));
			letterStart = Math.floor((columns - letterCols.length) / 2);

			cssWidth = width;
			cssHeight = ROWS * (cellSize + gap) - gap;
			offsetX = Math.max(0, (width - (columns * (cellSize + gap) - gap)) / 2);

			const dpr = window.devicePixelRatio || 1;
			canvas!.width = cssWidth * dpr;
			canvas!.height = cssHeight * dpr;
			canvas!.style.height = `${cssHeight}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			brightness = new Float32Array(columns * ROWS).fill(BASE_ALPHA);
		}

		function isLit(col: number, row: number) {
			const i = col - letterStart;
			if (i < 0 || i >= letterCols.length) return false;
			return letterCols[i][row];
		}

		function drawCell(col: number, row: number, alpha: number) {
			const x = offsetX + col * (cellSize + gap);
			const y = row * (cellSize + gap);
			if (alpha > 0.4) {
				ctx.shadowColor = `rgba(${ORANGE}, ${Math.min(alpha, 1)})`;
				ctx.shadowBlur = cellSize * 1.1;
			} else {
				ctx.shadowBlur = 0;
			}
			ctx.fillStyle = `rgba(${ORANGE}, ${alpha.toFixed(3)})`;
			if (typeof ctx.roundRect === 'function') {
				ctx.beginPath();
				ctx.roundRect(x, y, cellSize, cellSize, Math.min(2, cellSize / 3));
				ctx.fill();
			} else {
				ctx.fillRect(x, y, cellSize, cellSize);
			}
		}

		function drawSettled() {
			ctx.clearRect(0, 0, cssWidth, cssHeight);
			for (let c = 0; c < columns; c++) {
				for (let r = 0; r < ROWS; r++) {
					drawCell(c, r, isLit(c, r) ? 1 : BASE_ALPHA);
				}
			}
			ctx.shadowBlur = 0;
		}

		let animationToken = 0;

		function playSweep() {
			const token = ++animationToken;
			const start = performance.now();
			const totalRuntime = SWEEP_MS + LOCK_TAIL;
			let lastTime = start;

			function frame(now: number) {
				if (token !== animationToken) return; // superseded by a newer replay

				const dt = now - lastTime;
				lastTime = now;
				const elapsed = now - start;

				// Wave center travels from just left of column 0 to just right of
				// the last column, so the density falloff is visible entering and
				// leaving the grid rather than snapping in at the edges.
				const span = columns + 2 * HALF_BAND;
				const waveCenter = -HALF_BAND + span * Math.min(elapsed / SWEEP_MS, 1);

				ctx.clearRect(0, 0, cssWidth, cssHeight);
				for (let c = 0; c < columns; c++) {
					const d = c - waveCenter;
					for (let r = 0; r < ROWS; r++) {
						const idx = c * ROWS + r;
						const lit = isLit(c, r);
						const target = lit ? 1 : BASE_ALPHA;

						if (d > HALF_BAND) {
							// Wave hasn't reached this column yet.
							brightness[idx] = BASE_ALPHA;
						} else if (lit && d <= 0) {
							// The wave's center has reached this letter pixel — lock
							// it on for good instead of letting it keep sparking.
							const lock = 1 - Math.exp(-dt / LOCK_TAU);
							brightness[idx] += (1 - brightness[idx]) * lock;
						} else if (d >= -HALF_BAND) {
							// Inside the wave: random pixels spark, more often near
							// the center where density reaches 1 (guaranteed on).
							const density = 1 - Math.abs(d) / HALF_BAND;
							if (Math.random() < density) {
								brightness[idx] = 1;
							} else {
								const decay = Math.exp(-dt / SPARK_TAU);
								brightness[idx] = BASE_ALPHA + (brightness[idx] - BASE_ALPHA) * decay;
							}
						} else {
							// Wave has passed: settle into the final state.
							const lock = 1 - Math.exp(-dt / LOCK_TAU);
							brightness[idx] += (target - brightness[idx]) * lock;
						}

						drawCell(c, r, brightness[idx]);
					}
				}
				ctx.shadowBlur = 0;

				if (elapsed < totalRuntime) {
					requestAnimationFrame(frame);
				} else {
					drawSettled();
					sessionStorage.setItem(STORAGE_KEY, '1');
				}
			}

			requestAnimationFrame(frame);
		}

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const alreadyPlayed = sessionStorage.getItem(STORAGE_KEY) === '1';

		layout();
		if (reduceMotion || alreadyPlayed) {
			drawSettled();
			sessionStorage.setItem(STORAGE_KEY, '1');
		} else {
			playSweep();
		}

		if (!reduceMotion) {
			wrap.addEventListener('mouseenter', () => playSweep());
		}

		let resizeTimer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(() => {
				layout();
				drawSettled();
			}, 150);
		});
	}
</script>
