---
import { SITE_TITLE, SITE_DESCRIPTION, NAV_LINKS, SOCIAL_LINKS } from '../consts';
import LedHeader from '../components/LedHeader.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;

// Initial value for the footer clock, rendered at build time so there's no
// empty flash before public/site.js takes over and starts ticking it live.
const now = new Date();
const pad = (n: number) => String(n).padStart(2, '0');
const initialStamp =
	`${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ` +
	`${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<LedHeader />
		<nav class="site">
			{NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<main class="wrap">
			<slot />
		</main>
		<footer class="site">
			<ul class="plain social-links">
				{
					SOCIAL_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={link.label}
							>
								<img
									src={`https://cdn.simpleicons.org/${link.icon}/${link.color}`}
									width="24"
									height="24"
									alt=""
								/>
							</a>
						</li>
					))
				}
			</ul>
			<p>&copy; <time id="footer-clock">{initialStamp}</time> {SITE_TITLE}</p>
		</footer>
		<!--
			Shared, cached site script: drives the LED header animation and ticks
			the footer clock. One external file the browser fetches once, rather
			than an identical copy inlined into every page. Generated (minified)
			from src/site.client.js by `npm run build:client`.
		-->
		<script src="/site.js" defer></script>
	</body>
</html>
