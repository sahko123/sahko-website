---
import { SITE_TITLE, SITE_DESCRIPTION, NAV_LINKS, SOCIAL_LINKS } from '../consts';
import LedHeader from '../components/LedHeader.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	// Set on pages with no canonical "real" URL (404) — skips the canonical
	// link and og:url, and adds a noindex/nofollow robots tag.
	noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>

		<meta property="og:type" content="website" />
		{!noindex && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
	</head>
	<body>
		<LedHeader />
		<nav class="site">
			{NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<main class="wrap">
			<slot />
		</main>
		<footer class="site">
			<ul class="plain social-links">
				{
					SOCIAL_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={link.label}
							>
								<img
									src={`https://cdn.simpleicons.org/${link.icon}/${link.color}`}
									width="24"
									height="24"
									alt=""
								/>
							</a>
						</li>
					))
				}
			</ul>
			<!--
				No build-time value here on purpose: a static build can't know a
				visitor's timezone in advance, so there's nothing worth guessing —
				site.client.js fills this in with the visitor's actual local time
				within milliseconds of load, rather than showing a value in some
				other timezone that would then visibly jump once corrected.
			-->
			<p>&copy; <time id="footer-clock"></time> {SITE_TITLE}</p>
		</footer>
		<!--
			Shared site script: drives the LED header animation, the video
			carousel, and the footer clock. Astro/Vite bundles, minifies and
			content-hashes this into a single /_astro/*.js chunk that every page
			references identically — fetched once, cached forever (the hash in
			the filename means a new build is always a new URL, so it can never
			serve stale). astro.config.mjs pins assetsInlineLimit: 0 to keep
			this external regardless of how small the bundle gets.
		-->
		<script src="../site.client.js"></script>
	</body>
</html>
