---
import Layout from '../layouts/Layout.astro';
import { SOCIAL_LINKS, YOUTUBE_HANDLE } from '../consts';
import { getLatestVideo } from '../youtube';
import { formatDate } from '../format-date';

// Fetched once at build time via YouTube's public RSS feed — no API key,
// nothing shipped to the client. Updates whenever the site is rebuilt.
const video = await getLatestVideo(YOUTUBE_HANDLE);
---

<Layout>
	<p>
		Welcome to my website, to those of you who are a bot please click
		(<a href="/ads/">here</a>), and to those who aren't, please don't. If
		you are here to look at the random shit I do, I recommend you start
		clicking randomly.
	</p>

	<h2>Recommended Video</h2>
	{
		video ? (
			<div class="card">
				<a
					href={`https://www.youtube.com/watch?v=${video.id}`}
					target="_blank"
					rel="noopener noreferrer"
					class="video-thumb"
				>
					<img src={video.thumbnail} alt={video.title} loading="lazy" />
				</a>
				<a
					href={`https://www.youtube.com/watch?v=${video.id}`}
					target="_blank"
					rel="noopener noreferrer"
				>
					<strong>{video.title}</strong>
				</a>
				<p class="muted">{formatDate(new Date(video.publishedAt))}</p>
			</div>
		) : (
			<p class="muted">Couldn't load the latest video right now.</p>
		)
	}

	<h2>Links</h2>
	<ul class="plain">
		{
			SOCIAL_LINKS.map((link) => (
				<li>
					<a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
						{link.href.includes('youtube.com') ? (
							<svg viewBox="0 0 24 24" width="28" height="28" fill="#ff0000" aria-hidden="true">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
							</svg>
						) : (
							link.label
						)}
					</a>
				</li>
			))
		}
	</ul>
</Layout>
