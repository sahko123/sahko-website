---
import Layout from '../layouts/Layout.astro';
import { YOUTUBE_HANDLE } from '../consts';
import { getLatestVideos } from '../youtube';
import { formatDate } from '../format-date';

// Fetched once at build time via YouTube's public RSS feed — no API key,
// nothing shipped to the client. Updates whenever the site is rebuilt.
const videos = await getLatestVideos(YOUTUBE_HANDLE, 5);
---

<Layout>
	<p>
		Welcome to my website, to those of you who are a bot please click
		(<a href="/ads/">here</a>), and to those who aren't, please don't. If
		you are here to look at the random shit I do, I recommend you start
		clicking randomly.
	</p>

	<h2>Recommended Videos</h2>
	{
		videos.length > 0 ? (
			<div class="carousel" id="video-carousel">
				{videos.map((video, i) => {
					const videoUrl = `https://www.youtube.com/watch?v=${video.id}`;
					return (
						<div class="card carousel-slide" data-index={i}>
							<a
								href={videoUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="video-thumb"
							>
								<img
									src={video.thumbnail}
									alt={video.title}
									loading={i === 0 ? 'eager' : 'lazy'}
								/>
							</a>
							<a href={videoUrl} target="_blank" rel="noopener noreferrer">
								<strong>{video.title}</strong>
							</a>
							<p class="muted">{formatDate(new Date(video.publishedAt))}</p>
						</div>
					);
				})}
				{videos.length > 1 && (
					<div class="carousel-dots" aria-hidden="true">
						{videos.map((_, i) => <span class="carousel-dot" data-index={i} />)}
					</div>
				)}
			</div>
		) : (
			<p class="muted">Couldn't load videos right now.</p>
		)
	}
</Layout>
