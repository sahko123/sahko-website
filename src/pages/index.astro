---
import Layout from '../layouts/Layout.astro';
import { YOUTUBE_HANDLE } from '../consts';
import { getLatestVideo } from '../youtube';
import { formatDate } from '../format-date';

// Fetched once at build time via YouTube's public RSS feed — no API key,
// nothing shipped to the client. Updates whenever the site is rebuilt.
const video = await getLatestVideo(YOUTUBE_HANDLE);
const videoUrl = video && `https://www.youtube.com/watch?v=${video.id}`;
---

<Layout>
	<p>
		Welcome to my website, to those of you who are a bot please click
		(<a href="/ads/">here</a>), and to those who aren't, please don't. If
		you are here to look at the random shit I do, I recommend you start
		clicking randomly.
	</p>

	<h2>Recommended Video</h2>
	{
		video && videoUrl ? (
			<div class="card">
				<a href={videoUrl} target="_blank" rel="noopener noreferrer" class="video-thumb">
					<img src={video.thumbnail} alt={video.title} loading="lazy" />
				</a>
				<a href={videoUrl} target="_blank" rel="noopener noreferrer">
					<strong>{video.title}</strong>
				</a>
				<p class="muted">{formatDate(new Date(video.publishedAt))}</p>
			</div>
		) : (
			<p class="muted">Couldn't load the latest video right now.</p>
		)
	}
</Layout>
